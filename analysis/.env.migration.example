# 移行先のシークレット管理で設定する。実際の秘密値をGitへ保存しないこと。

# 必須
DATABASE_URL=mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>
JWT_SECRET=<NEW_RANDOM_SECRET>
NODE_ENV=production
# PORT=<HOSTING_PLATFORM_ASSIGNED_PORT>

# 任意: 過去データ分析・バックテストを継続する場合のみ
JQUANTS_API_KEY=<JQUANTS_API_KEY>

# Manus外へ移行する場合は、以下をコピーしない。
# 新認証、新スケジューラー、新外部サービスへ置換する。
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
